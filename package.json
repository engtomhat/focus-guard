{
  "name": "focus-guard",
  "version": "2.2.1",
  "type": "module",
  "description": "Browser extension to block distracting websites",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22"
  }
}
